{
  "name": "display",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:server dev:tailwind",
    "build": "run-s build:types build-only build:css",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "build:css": "npx tailwindcss -i ./src/styles/custom-style.css -o ./dist/tailwind-styles.css",
    "dev:server": "vite",
    "dev:tailwind": "npx tailwindcss -i ./src/styles/custom-style.css -o ./dist/tailwind-styles.css --watch",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@zxing/browser": "^0.1.5",
    "pinia": "^2.2.6",
    "simple-keyboard": "^3.8.0",
    "swipe-keyboard": "^2.2.511",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.9.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "npm-run-all2": "^7.0.1",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.3",
    "vite": "^6.0.1",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-vue-devtools": "^7.6.5",
    "vue-tsc": "^2.1.10"
  }
}
